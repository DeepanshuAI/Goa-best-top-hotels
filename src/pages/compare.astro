---
import Base from '../layouts/Base.astro';
import { hotels } from '../data/hotels';
const criteria = [
  { key:'setting', label:'Setting & beach access' },
  { key:'scale', label:'Property scale' },
  { key:'pool', label:'Pool' },
  { key:'family', label:'Family facilities' },
  { key:'wellness', label:'Wellness' },
  { key:'food', label:'Dining' },
] as const;
---
<Base title="Compare Goa hotels | Goa, Considered" description="Compare ten Goa hotels by location, property scale, pools, family facilities, wellness and dining, with source gaps clearly marked.">
  <div class="wrap content compare-page">
    <p class="breadcrumb"><a href="/">Home</a> / Compare</p>
    <p class="kicker">Side by side</p>
    <h1>Compare Goa hotels</h1>
    <p class="page-intro">Compare up to four selected stays or view the full curated selection. Criteria focus on practical differences that can shape a trip, not ratings or live prices.</p>
    <p class="callout" data-selection-note aria-live="polite">All ten properties are shown. Select up to four on the shortlist for a focused comparison.</p>
    <p class="comparison-key"><strong>How to read this:</strong> “Not stated in the source checked” means we could not verify that detail in the linked official information; it does not mean the property lacks it. Facility availability can change.</p>
    <div class="compare-actions"><a class="text-link" href="/#hotel-selection">Change selection on the shortlist</a><button type="button" class="text-button" data-clear-compare>Clear saved selection</button></div>
    <div class="table-wrap"><table class="compare-table comparison-matrix"><thead><tr><th scope="col">Hotel</th>{criteria.map(c=><th scope="col">{c.label}</th>)}</tr></thead><tbody>{hotels.map(h=><tr data-compare-hotel={h.slug}><th scope="row"><div class="comparison-property"><img src={h.thumbnail} alt="" width="72" height="48" loading="lazy" decoding="async"/><div><a href={`/hotels/${h.slug}/`}>{h.name}</a><span class="table-locality">{h.region} · {h.locality}</span><a class="official-link" href={h.officialUrl} target="_blank" rel="noreferrer">Official information ↗</a></div></div></th>{criteria.map(c=><td data-label={c.label} class:list={{'unavailable':h.comparison[c.key]==='Not stated in the source checked'}}>{h.comparison[c.key]}</td>)}</tr>)}</tbody></table></div>
    <p class="source-note">Details are checked against the official pages linked from each hotel profile; check dates appear on those profiles. See <a href="/sources-and-corrections/">how we source and correct details</a>, and the <a href="/methodology/">selection method</a>.</p>
    <p><a href="/">Back to the hotel shortlist</a></p>
  </div>
  <script>
    const query = new URLSearchParams(location.search).get('hotels');
    const valid = new Set([...document.querySelectorAll<HTMLElement>('[data-compare-hotel]')].map(row => row.dataset.compareHotel).filter(Boolean));
    const key = 'goa-considered-compare';
    let chosen: string[] = [];
    if (query !== null) chosen = [...new Set(query.split(',').filter((slug): slug is string => valid.has(slug)))].slice(0,4);
    else { try { const saved = JSON.parse(localStorage.getItem(key) ?? '[]'); if (Array.isArray(saved)) chosen = saved.filter((slug): slug is string => typeof slug === 'string' && valid.has(slug)).slice(0,4); } catch { chosen = []; } }
    const rows = [...document.querySelectorAll<HTMLElement>('[data-compare-hotel]')];
    if (chosen.length) {
      const clearButton = document.querySelector<HTMLButtonElement>('[data-clear-compare]');
      if (clearButton) clearButton.hidden = false;
      try { localStorage.setItem(key, JSON.stringify(chosen)); } catch { /* showing this selection does not require storage */ }
      for (const row of rows) row.hidden = !chosen.includes(row.dataset.compareHotel ?? '');
      const note = document.querySelector<HTMLElement>('[data-selection-note]');
      if (note) note.textContent = `Showing ${chosen.length} selected ${chosen.length === 1 ? 'hotel' : 'hotels'}.`;
    }
    if (query !== null && chosen.length === 0) {
      try { localStorage.removeItem(key); } catch { /* selection is still cleared for this page view */ }
      const note = document.querySelector<HTMLElement>('[data-selection-note]');
      if (note) note.textContent = 'No hotels selected. All ten properties are shown.';
    }
    document.querySelector<HTMLButtonElement>('[data-clear-compare]')?.addEventListener('click', () => {
      try { localStorage.removeItem(key); } catch { /* selection is still cleared for this page view */ }
      for (const row of rows) row.hidden = false;
      const note = document.querySelector<HTMLElement>('[data-selection-note]');
      if (note) note.textContent = 'Saved selection cleared. All ten properties are shown.';
    });
  </script>
</Base>
