---
import Base from '../../layouts/Base.astro'; import { hotels } from '../../data/hotels';
export function getStaticPaths(){return hotels.map(h=>({params:{slug:h.slug},props:{hotel:h}}));}
const {hotel}=Astro.props; const title=`${hotel.name}: location, facilities & fit | Goa, Considered`;const checkedLabel=new Date(`${hotel.checked}T12:00:00Z`).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
---
<Base title={title} description={`A sourced profile of ${hotel.name} in ${hotel.locality}, Goa: who it may suit, source-listed facilities and practical trade-offs.`}><div class="wrap content"><p class="breadcrumb"><a href="/">Home</a> / <a href="/">Hotel shortlist</a> / {hotel.name}</p><p class="kicker">{hotel.region} · {hotel.locality}</p><h1>{hotel.name}</h1><p class="page-intro">{hotel.bestFor}. This profile separates source-listed facts from our editorial view and highlights what to check before booking.</p><div class="callout">A research-based profile. We have not visited or independently audited this property. Official source checked {checkedLabel}.</div><figure class="profile-photo"><img src={hotel.image} alt={hotel.imageAlt} width={hotel.imageWidth} height={hotel.imageHeight} loading="eager" fetchpriority="high" decoding="async"/><figcaption>{hotel.name}</figcaption></figure><h2>Why it is on the list</h2><p>{hotel.overview}</p><h2>Who might like it</h2><p>{hotel.rationale}</p><div class="profile-grid"><section class="info-panel"><h2>Details listed by the source</h2><ul>{hotel.facilities.map(f=><li>{f}</li>)}</ul><p><strong>Property type:</strong> {hotel.type}</p><p><strong>Area:</strong> {hotel.locality}, {hotel.region}</p></section><section class="info-panel"><h2>Consider before booking</h2><p>{hotel.tradeoff}</p><p>Rates, room availability, seasonal operations and specific inclusions can change. Confirm them directly with the hotel.</p></section></div><h2>Official information</h2><p>For current rooms, facilities, location details and booking terms, use the <a href={hotel.officialUrl} target="_blank" rel="noreferrer">official property website</a>.</p><h2>Source note</h2><p>Material property details on this page were checked against the <a href={hotel.sourceUrl} target="_blank" rel="noreferrer">official source</a> on {checkedLabel}. The “best for” label and comparison are our editorial interpretation, not a hotel claim.</p><h2>Compare nearby and relevant alternatives</h2><p><a href={`/compare/?hotels=${hotel.slug}`}>Compare this stay</a> with others. Return to the <a href="/">full Goa shortlist</a>, or compare <a href="/north-goa-hotels/">North Goa stays</a>, <a href="/south-goa-hotels/">South Goa stays</a>, and <a href="/guides/north-goa-vs-south-goa/">the regions</a>.</p></div></Base>
