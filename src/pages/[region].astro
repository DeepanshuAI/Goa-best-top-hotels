---
import Base from '../layouts/Base.astro';import HotelRow from '../components/HotelRow.astro';import {hotels} from '../data/hotels';
export function getStaticPaths(){const pages=[{slug:'north-goa-hotels',region:'North Goa',label:'North Goa hotels',intro:'A shortlist for travellers who want the northern coast’s lively beach belt, from Vagator and Anjuna to the Sinquerim-Candolim area.'},{slug:'south-goa-hotels',region:'South Goa',label:'South Goa hotels',intro:'A shortlist for travellers considering resort stays and the slower coastal settings around Arossim, Majorda, Colva and Benaulim.'},{slug:'central-goa-stays',region:'Central Goa',label:'Central Goa stays',intro:'An editorial central Goa grouping: a city base in Panaji and an independent riverside stay in Goa Velha. Consider these for city, heritage or inland plans rather than a beach-first itinerary; “central Goa” is not an administrative region.'}];
return pages.map(p=>({params:{region:p.slug},props:{page:p}}));}
const {page}=Astro.props;const matches=hotels.filter(h=>h.region===page.region);const title=`${page.label} to consider | Goa, Considered`;const checkedDates=[...new Set(matches.map(h=>h.checked))];const checkedLabel=checkedDates.length===1?`Official sources checked ${new Date(checkedDates[0]+'T12:00:00Z').toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}`:'See individual profile check dates';
---
<Base title={title} description={page.intro}><div class="wrap"><section class="hero"><p class="kicker">Regional shortlist</p><h1>{page.label}</h1><p class="lead">{page.intro}</p><p class="meta-line">{matches.length} researched properties · {checkedLabel}</p></section><div class="callout">These regional pages help compare different trip bases. They are not complete hotel directories and do not show live rates. Central Goa is an editorial grouping, not an official administrative region.</div><div class="hotel-list">{matches.map((hotel,index)=><HotelRow hotel={hotel} position={index+1} showPosition={false}/>)}</div><section class="content"><h2>Choose your base with the trip in mind</h2><p>For a region-to-region comparison, read <a href="/guides/north-goa-vs-south-goa/">North Goa vs South Goa</a>. Browse the <a href="/">full ten-hotel list</a> or the <a href="/guides/best-areas-to-stay-in-goa/">area guide</a>.</p></section></div></Base>
